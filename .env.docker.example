# Environment for `docker compose` (copy to .env.docker — it is gitignored).
# Host names below are the compose service names. Generate APP_KEY with:
#   sed -i "s|^APP_KEY=.*|APP_KEY=base64:$(openssl rand -base64 32)|" .env.docker

APP_NAME="Support Desk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=app
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=support_desk
DB_USERNAME=support_desk
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root-secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queue stays on the database driver (the queue health checks read the `jobs` table); Redis backs the cache.
QUEUE_CONNECTION=database
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

FILESYSTEM_DISK=local

# Server side: the app reaches Reverb over the docker network.
# The browser side (VITE_REVERB_*) is compiled into the JS at build time — see docker-compose.yml build args.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=support-desk
REVERB_APP_KEY=support-desk-local-key
REVERB_APP_SECRET=support-desk-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SUPPORT_SLA_TIMEZONE=Asia/Dhaka
SUPPORT_SLA_WARNING_THRESHOLD_PERCENT=80
SUPPORT_ASSIGNMENT_STRATEGY=least_workload
SUPPORT_UPLOADS_MAX_FILES=5
SUPPORT_UPLOADS_MAX_KB=5120
SUPPORT_IMPORT_CHUNK_SIZE=500
SUPPORT_IMPORT_MAX_KB=20480
SUPPORT_DASHBOARD_CACHE_TTL=60
SUPPORT_DASHBOARD_STUCK_AFTER_DAYS=3
SUPPORT_REPORTS_EXPORT_SYNC_LIMIT=50000
SUPPORT_REPORTS_EXPORT_TTL_DAYS=7
SUPPORT_SLOW_QUERY_MS=500
SUPPORT_FAILED_JOB_ALERT_MINUTES=10
HEALTH_SECRET=

AUDIT_AUTH_RETENTION_DAYS=180
AUDIT_ADMIN_RETENTION_DAYS=1095
AUDIT_PAGE_DEFAULT_DAYS=30
