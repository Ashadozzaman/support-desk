APP_NAME="Support Desk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=app
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=support_desk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SUPPORT_SLA_TIMEZONE=Asia/Dhaka
SUPPORT_SLA_WARNING_THRESHOLD_PERCENT=80
SUPPORT_ASSIGNMENT_STRATEGY=least_workload
SUPPORT_UPLOADS_MAX_FILES=5
SUPPORT_UPLOADS_MAX_KB=5120
SUPPORT_IMPORT_CHUNK_SIZE=500
SUPPORT_IMPORT_MAX_KB=20480
SUPPORT_DASHBOARD_CACHE_TTL=60
SUPPORT_DASHBOARD_STUCK_AFTER_DAYS=3
SUPPORT_REPORTS_EXPORT_SYNC_LIMIT=50000
SUPPORT_REPORTS_EXPORT_TTL_DAYS=7
SUPPORT_SLOW_QUERY_MS=500
SUPPORT_FAILED_JOB_ALERT_MINUTES=10

# REST API (docs/API.md): personal access token lifetime in minutes (default 30 days)
SANCTUM_TOKEN_EXPIRATION=43200
# Secret for GET /health (X-Health-Secret header). Empty disables the endpoint.
HEALTH_SECRET=

# Audit log (Step 19c) — retention per log (activitylog:clean, daily); ticket history is never deleted
AUDIT_AUTH_RETENTION_DAYS=180
AUDIT_ADMIN_RETENTION_DAYS=1095
AUDIT_PAGE_DEFAULT_DAYS=30

# AI assistant (Step 22, docs/ENHANCEMENTS.md §3). Off by default: the app works without a key.
# AI_PROVIDER=anthropic|openai + its key are only used when AI_ENABLED=true; otherwise a fake client answers.
AI_ENABLED=false
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=claude-opus-5-5
# Optional per-feature models (empty = AI_MODEL), e.g. AI_MODEL_CHAT=claude-haiku-5-5
AI_MODEL_TRIAGE=
AI_MODEL_REPLY_DRAFT=
AI_MODEL_SUMMARY=
AI_MODEL_CHAT=
AI_MAX_TOKENS=4096
AI_EFFORT=medium
AI_TIMEOUT=15
AI_RETRIES=2
AI_DAILY_TOKEN_BUDGET=200000
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200
AI_CIRCUIT_FAILURES=5
AI_CIRCUIT_COOLDOWN_SECONDS=300
AI_REDACT_PII=true
AI_RETENTION_DAYS=90
AI_REFUSAL_FALLBACK=true
# Support chatbot (Step 24)
AI_CHAT_ARTICLES=4
AI_CHAT_HISTORY_MESSAGES=8
AI_CHAT_MAX_MESSAGE_LENGTH=1000
AI_CHAT_REQUESTS_PER_MINUTE=6
AI_CHAT_MAX_TOKENS=2048
AI_CHAT_RETENTION_DAYS=30
# Staff data assistant (Step 24b)
AI_MODEL_DATA_ASSISTANT=
AI_DATA_ASSISTANT_MAX_ROUNDS=4
AI_DATA_ASSISTANT_MAX_ROWS=20
